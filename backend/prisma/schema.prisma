// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  firmName  String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  designs   Design[]
  catalogues Catalogue[]
  contacts  Contact[]
  shareLinks ShareLink[]
  orders    Order[]
}

model Catalogue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  designs   Design[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

model Design {
  id            String   @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogueId   String?
  catalogue     Catalogue? @relation(fields: [catalogueId], references: [id], onDelete: SetNull)
  name          String?  // Design name (optional for backward compatibility)
  image         String   // Base64 or URL
  designCode    String?  // Optional design code for AI matching
  color         String?  // Optional color
  stockQuantity Int?     // Optional stock quantity
  basePrice     Float?   // Base price (replaces wholesalePrice/retailPrice) - nullable for migration
  additionalPrices Json?  // Additional price types: [{name: "WSP", type: "percentage|fixed", value: 5}]
  wholesalePrice Float   @default(0) // Kept for backward compatibility
  retailPrice    Float   @default(0) // Kept for backward compatibility
  fabric         String
  description    String?
  shareLinks     ShareLink[]
  shareLinkDesigns ShareLinkDesign[]
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([catalogueId])
  @@index([fabric])
  @@index([createdAt])
}

model Contact {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String
  isSaved     Boolean  @default(false) // Whether this contact has saved user's number
  lastShared  DateTime?
  deliveryStatus String? // 'delivered', 'undelivered', 'unknown'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@unique([userId, phoneNumber])
}

model ShareLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId    String?
  design      Design?   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designs     ShareLinkDesign[]
  orders      Order[]
  token       String   @unique // Unique token for the shareable link
  expiresAt   DateTime? // Optional expiration date
  isActive    Boolean  @default(true) // Can be disabled by user
  selectedPriceType String? // Which price type to show (base, or name of additional price)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([designId])
  @@index([token])
  @@index([isActive])
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  designId    String
  design      Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  buyerName   String
  buyerPhone  String
  quantity    Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([shareLinkId])
  @@index([designId])
  @@index([status])
  @@index([createdAt])
}

model OrderDraft {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText  String
  draftJson   Json
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ShareLinkDesign {
  id         String   @id @default(cuid())
  shareLinkId String
  designId   String
  shareLink  ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  design     Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([shareLinkId])
  @@index([designId])
  @@unique([shareLinkId, designId])
}

