// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  firmName  String?
  password  String
  trialEndsAt DateTime?
  subscriptionStatus String?
  subscriptionPlan String?
  subscriptionStartedAt DateTime?
  subscriptionEndsAt DateTime?
  razorpayCustomerId String?
  razorpaySubscriptionId String?
  freeOverride Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  designs   Design[]
  catalogues Catalogue[]
  contacts  Contact[]
  customers Customer[]
  shareLinks ShareLink[]
  orders    Order[]
  orderDrafts OrderDraft[]
}

model Catalogue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  designs   Design[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

model Design {
  id            String   @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogueId   String?
  catalogue     Catalogue? @relation(fields: [catalogueId], references: [id], onDelete: SetNull)
  name          String?  // Design name (optional for backward compatibility)
  image         String   // Base64 or URL
  designCode    String?  // Optional design code for AI matching
  color         String?  // Optional color
  stockQuantity Int?     @default(1000) // Stock quantity
  stockUnit     String?  @default("pcs") // "pcs" or "mtrs"
  pcsPerParcel  Int?     // How many pieces in one parcel
  moq           Int?     // Minimum order quantity (optional)
  basePrice     Float?   // Base price (replaces wholesalePrice/retailPrice) - nullable for migration
  additionalPrices Json?  // Additional price types: [{name: "WSP", type: "percentage|fixed", value: 5}]
  costingDetails Json?    // Optional costing calculator data (materials, jobs, other costs)
  wholesalePrice Float   @default(0) // Kept for backward compatibility
  retailPrice    Float   @default(0) // Kept for backward compatibility
  fabric         String
  description    String?
  aiModels       Json?    // Optional: base64 images from AI modelling (model wearing design)
  shareLinks     ShareLink[]
  shareLinkDesigns ShareLinkDesign[]
  shareLinkDesignViews ShareLinkDesignView[]
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([catalogueId])
  @@index([fabric])
  @@index([createdAt])
}

model Contact {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String
  isSaved     Boolean  @default(false) // Whether this contact has saved user's number
  lastShared  DateTime?
  deliveryStatus String? // 'delivered', 'undelivered', 'unknown'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@unique([userId, phoneNumber])
}

model Customer {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName  String
  gstNumber         String?
  contactPersonName String?
  mobileNumber      String?
  agentName         String?
  category          String?
  state             String?
  city              String?
  pincode           String?
  discountRate      Float?
  orders            Order[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([organizationName])
  @@index([mobileNumber])
}

model ShareLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId    String?
  design      Design?   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designs     ShareLinkDesign[]
  orders      Order[]
  opens       ShareLinkOpen[]
  designViews ShareLinkDesignView[]
  token       String   @unique // Unique token for the shareable link
  expiresAt   DateTime? // Optional expiration date
  isActive    Boolean  @default(true) // Can be disabled by user
  selectedPriceType String? // Which price type to show (base, or name of additional price)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([designId])
  @@index([token])
  @@index([isActive])
}

model ShareLinkOpen {
  id          String   @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  sessionId   String?   // Client session to avoid double-counting same visitor
  openedAt    DateTime @default(now())

  @@index([shareLinkId])
  @@index([openedAt])
}

model ShareLinkDesignView {
  id          String   @id @default(cuid())
  shareLinkId String
  designId    String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  design      Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  sessionId   String?
  viewedAt    DateTime @default(now())

  @@index([shareLinkId])
  @@index([designId])
  @@index([viewedAt])
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinkId String?
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  designId    String?
  design      Design?   @relation(fields: [designId], references: [id], onDelete: Cascade)
  buyerName   String
  buyerPhone  String
  quantity    Int
  status      String   @default("pending")
  remarks     String? // seller notes on manual orders
  manualType  String? // open | design; null for share-link orders
  manualBatchId String? // groups design lines from one manual submit
  priceCategory String?
  orderNumber String?
  agentName String?
  transportName String?
  discountRate Float?
  shippingCharge Float?
  orderDate DateTime?
  expectedDate DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([shareLinkId])
  @@index([customerId])
  @@index([designId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([manualBatchId])
}

model OrderDraft {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText  String
  draftJson   Json
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ShareLinkDesign {
  id         String   @id @default(cuid())
  shareLinkId String
  designId   String
  shareLink  ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  design     Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([shareLinkId])
  @@index([designId])
  @@unique([shareLinkId, designId])
}

